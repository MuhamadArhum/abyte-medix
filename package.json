{
  "name": "abyte-medix",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "npm run start:dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true,
    "@prisma/engines": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
