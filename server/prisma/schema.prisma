generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Access Control ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_STAFF
}

model User {
  id               Int      @id @default(autoincrement())
  username         String   @unique @db.VarChar(50)
  passwordHash     String   @db.VarChar(255)
  fullName         String   @db.VarChar(100)
  role             Role
  isActive         Boolean  @default(true)
  allowedTerminals String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  permissions  UserPermission[]
  sessions     RefreshToken[]
  sales        Sale[]
  auditLogs    AuditLog[]

  @@index([username])
}

model UserPermission {
  id      Int     @id @default(autoincrement())
  userId  Int
  module  String  @db.VarChar(50)
  action  String  @db.VarChar(50)
  granted Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, action])
  @@index([userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(100)
  createdAt DateTime   @default(now())
  medicines Medicine[]
}

model Manufacturer {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(150)
  createdAt DateTime   @default(now())
  medicines Medicine[]
}

model Medicine {
  id                   Int      @id @default(autoincrement())
  productCode          String?  @unique @db.VarChar(50)
  barcode              String?  @db.VarChar(100)
  brandName            String   @db.VarChar(150)
  genericName          String?  @db.VarChar(150)
  strength             String?  @db.VarChar(50)
  dosageForm           String?  @db.VarChar(50)
  packSize             String?  @db.VarChar(50)
  unit                 String?  @db.VarChar(30)
  taxRate              Decimal  @default(0) @db.Decimal(5, 2)
  reorderLevel         Int      @default(0)
  prescriptionRequired Boolean  @default(false)
  isActive             Boolean  @default(true)
  categoryId           Int?
  manufacturerId       Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category     Category?     @relation(fields: [categoryId], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  batches      Batch[]

  @@index([barcode])
  @@index([brandName])
  @@index([genericName])
  @@index([productCode])
}

model Batch {
  id           Int       @id @default(autoincrement())
  medicineId   Int
  batchNumber  String    @db.VarChar(100)
  mfgDate      DateTime?
  expiryDate   DateTime
  purchaseRate Decimal   @db.Decimal(10, 2)
  saleRate     Decimal   @db.Decimal(10, 2)
  quantity     Int       @default(0)
  freeQuantity Int       @default(0)
  supplierId   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  medicine            Medicine             @relation(fields: [medicineId], references: [id])
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockMovements      StockMovement[]

  @@index([medicineId])
  @@index([expiryDate])
  @@index([batchNumber])
}

// ─── Parties ──────────────────────────────────────────────────────────────────

model Customer {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(150)
  phone              String?  @db.VarChar(20)
  address            String?  @db.Text
  creditLimit        Decimal  @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sales        Sale[]
  payments     Payment[]
  salesReturns SaleReturn[]

  @@index([name])
  @@index([phone])
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(150)
  contactPerson  String?  @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  address        String?  @db.Text
  payableBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases       Purchase[]
  payments        Payment[]
  batches         Batch[]
  purchaseReturns PurchaseReturn[]

  @@index([name])
}

// ─── Sales ────────────────────────────────────────────────────────────────────

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
  SPLIT
}

model Sale {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique @db.VarChar(50)
  customerId     Int?
  userId         Int
  terminalId     String?       @db.VarChar(50)
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())

  customer Customer?  @relation(fields: [customerId], references: [id])
  user     User       @relation(fields: [userId], references: [id])
  items    SaleItem[]
  returns  SaleReturn[]
  payments Payment[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id       Int     @id @default(autoincrement())
  saleId   Int
  batchId  Int
  quantity Int
  saleRate Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(5, 2)
  taxRate  Decimal @default(0) @db.Decimal(5, 2)
  total    Decimal @db.Decimal(12, 2)

  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id])

  @@index([saleId])
}

model SaleReturn {
  id           Int      @id @default(autoincrement())
  saleId       Int
  customerId   Int?
  reason       String   @db.Text
  refundAmount Decimal  @db.Decimal(12, 2)
  refundMethod String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  sale     Sale             @relation(fields: [saleId], references: [id])
  customer Customer?        @relation(fields: [customerId], references: [id])
  items    SaleReturnItem[]

  @@index([saleId])
}

model SaleReturnItem {
  id           Int     @id @default(autoincrement())
  saleReturnId Int
  batchId      Int
  quantity     Int
  isDamaged    Boolean @default(false)
  refundAmount Decimal @db.Decimal(12, 2)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  batch      Batch      @relation(fields: [batchId], references: [id])

  @@index([saleReturnId])
}

// ─── Purchasing ───────────────────────────────────────────────────────────────

enum PurchaseStatus {
  DRAFT
  RECEIVED
  PARTIAL
}

model Purchase {
  id             Int            @id @default(autoincrement())
  invoiceNumber  String         @unique @db.VarChar(50)
  supplierId     Int
  status         PurchaseStatus @default(RECEIVED)
  subtotal       Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  amountPaid     Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?        @db.Text
  purchaseDate   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  items     PurchaseItem[]
  returns   PurchaseReturn[]
  payments  Payment[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id           Int     @id @default(autoincrement())
  purchaseId   Int
  batchId      Int
  quantity     Int
  freeQuantity Int     @default(0)
  purchaseRate Decimal @db.Decimal(10, 2)
  saleRate     Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(5, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  total        Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@index([purchaseId])
}

model PurchaseReturn {
  id          Int      @id @default(autoincrement())
  purchaseId  Int
  supplierId  Int
  reason      String   @db.Text
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  purchase  Purchase             @relation(fields: [purchaseId], references: [id])
  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  items     PurchaseReturnItem[]

  @@index([purchaseId])
}

model PurchaseReturnItem {
  id               Int     @id @default(autoincrement())
  purchaseReturnId Int
  batchId          Int
  quantity         Int
  amount           Decimal @db.Decimal(12, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id])

  @@index([purchaseReturnId])
}

// ─── Finance ──────────────────────────────────────────────────────────────────

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  EXPENSE
  INCOME
}

model Payment {
  id         Int         @id @default(autoincrement())
  type       PaymentType
  amount     Decimal     @db.Decimal(12, 2)
  method     String?     @db.VarChar(50)
  reference  String?     @db.VarChar(100)
  notes      String?     @db.Text
  customerId Int?
  supplierId Int?
  saleId     Int?
  purchaseId Int?
  createdAt  DateTime    @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  sale     Sale?     @relation(fields: [saleId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([customerId])
  @@index([supplierId])
  @@index([createdAt])
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String   @db.VarChar(100)
  description String?  @db.Text
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
}

model Income {
  id          Int      @id @default(autoincrement())
  category    String   @db.VarChar(100)
  description String?  @db.Text
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum MovementType {
  SALE
  SALE_RETURN
  PURCHASE
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRY_WRITEOFF
}

model StockMovement {
  id          Int          @id @default(autoincrement())
  batchId     Int
  type        MovementType
  quantity    Int
  reason      String?      @db.VarChar(255)
  referenceId Int?
  createdAt   DateTime     @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([createdAt])
}

// ─── System ───────────────────────────────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  module     String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  recordId   Int?
  oldValue   Json?
  newValue   Json?
  terminalId String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Backup {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(255)
  size      BigInt?
  status    String   @db.VarChar(20)
  location  String?  @db.VarChar(500)
  createdAt DateTime @default(now())
}

model License {
  id             Int       @id @default(autoincrement())
  licenseKey     String    @unique @db.VarChar(500)
  customerId     String?   @db.VarChar(100)
  storeName      String    @db.VarChar(150)
  plan           String    @db.VarChar(50)
  maxPos         Int       @default(1)
  activationDate DateTime?
  expiryDate     DateTime?
  features       Json?
  status         String    @db.VarChar(20)
  lastValidatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
